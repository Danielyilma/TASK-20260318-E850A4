# Copy to `.env` and adjust as needed. Docker Compose sets most values inline.

# Backend
DATABASE_URL=postgresql://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local file storage for materials and invoices (Docker Compose sets UPLOAD_ROOT on the backend)
# UPLOAD_ROOT=data/uploads
# BACKUP_ROOT=data/backups

# Auth / bootstrap (Docker Compose sets these too)
JWT_SECRET_KEY=dev-jwt-secret-change-me
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=AdminP@ss1

# Frontend (Vite; optional — defaults infer http://<hostname>:8000/api/v1)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tests (optional; defaults to in-memory SQLite with StaticPool)
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app

# Copy to `.env` and adjust as needed. Docker Compose sets most values inline.

# Backend
DATABASE_URL=postgresql://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local file storage for materials and invoices (Docker Compose sets UPLOAD_ROOT on the backend)
# UPLOAD_ROOT=data/uploads
# BACKUP_ROOT=data/backups
# BACKUP_DAILY_ENABLED=true
# BACKUP_DAILY_HOUR_UTC=2
# BACKUP_RETENTION_DAYS=14

# Auth / bootstrap (Docker Compose sets these too)
JWT_SECRET_KEY=change_this_to_a_secure_random_string
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=change_this_to_a_secure_password
# Optional: Fernet key for decrypting ENC(...) values in sensitive settings.
# CONFIG_ENCRYPTION_KEY=

# Frontend (Vite; optional — defaults infer http://<hostname>:8000/api/v1)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tests (optional; defaults to in-memory SQLite with StaticPool)
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app
